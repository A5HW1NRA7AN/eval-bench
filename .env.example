# Copy to .env and fill in. Never commit .env.

# Which LLM writes facts and questions: ollama (local) or gemma (remote Gemma 4, daytime only).
LLM_PROVIDER=ollama

# Local Ollama (OpenAI-compatible API).
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4:12b

# Remote Gemma 4 behind LiteLLM (OpenAI-compatible URL ending in /v1; ask the team for it and the key).
GEMMA_URL=
GEMMA_API_KEY=
GEMMA_MODEL=gemma-4-31b-it

# Embeddings for the local test bed (served by Ollama).
EMBED_MODEL=bge-m3

# Local Qdrant test bed (docker compose up -d).
QDRANT_URL=http://127.0.0.1:6333

# Optional override:
# LLM_REASONING=none         # reasoning_effort sent to the model; empty to omit it
